     /**
+     * Request or waive the publication fee, as the editor chose on the payment step
+     */
+    protected function runPaymentAction(array $action, Submission $submission, User $editor, Context $context): void
+    {
+        // The decision page posts form-encoded data, so "Waive" arrives as the string "false";
+        // validatePaymentAction() has refused anything that is not a boolean
+        if (filter_var($action['requestPayment'], FILTER_VALIDATE_BOOLEAN)) {
+            $this->requestPayment($submission, $editor, $context);
+        } else {
+            $this->waivePayment($submission, $editor, $context);
+        }
+    }
+
+    /**
+     * Record the publication fee as waived, as the workflow's "Payments" menu does,
+     * unless the fee is already recorded as paid or waived
+     */
+    protected function waivePayment(Submission $submission, User $editor, Context $context): void
+    {
+        $completedPaymentDao = DAORegistry::getDAO('OJSCompletedPaymentDAO'); /** @var OJSCompletedPaymentDAO $completedPaymentDao */
+        if ($completedPaymentDao->getByAssoc(null, OJSPaymentManager::PAYMENT_TYPE_PUBLICATION, $submission->getId())) {
+            return;
+        }
+
+        $request = Application::get()->getRequest();
+        $paymentManager = Application::get()->getPaymentManager($context);
+        $queuedPayment = $paymentManager->createQueuedPayment(
+            $request,
+            OJSPaymentManager::PAYMENT_TYPE_PUBLICATION,
+            $editor->getId(),
+            $submission->getId(),
+            0,
+            '' // Zero amount, no currency
+        );
+        $paymentManager->queuePayment($queuedPayment);
+        $paymentManager->fulfillQueuedPayment($request, $queuedPayment, 'ManualPayment');
+    }
