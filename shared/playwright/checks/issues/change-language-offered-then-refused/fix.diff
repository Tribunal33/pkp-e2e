     /**
+     * Check if a user may change the submission language, by the rules that
+     * authorize PUT submissions/{id}/publications/{id}/changeLocale: the route's
+     * roles (PKPSubmissionController::getGroupRoutes()), then PublicationWritePolicy
+     * (StageRolePolicy and PublicationCanBeEditedPolicy). Whether the submission's
+     * state allows a change is left to PKPSubmissionController::changeLocale().
+     */
+    public function canChangeLocale(Submission $submission, Publication $publication, User $user): bool
+    {
+        $contextId = $submission->getData('contextId');
+
+        // The route admits these context roles only
+        if (!$user->hasRole([Role::ROLE_ID_MANAGER, Role::ROLE_ID_SUB_EDITOR], $contextId)) {
+            return false;
+        }
+
+        $isSiteAdmin = $user->hasRole([Role::ROLE_ID_SITE_ADMIN], Application::SITE_CONTEXT_ID);
+
+        // StageRolePolicy: managers and admins pass, others need a role on the current stage
+        if (!$isSiteAdmin && !$user->hasRole([Role::ROLE_ID_MANAGER], $contextId)) {
+            $stages = Repo::user()->getAccessibleWorkflowStages($user->getId(), $contextId, $submission);
+            $stageRoles = $stages[$submission->getData('stageId')] ?? [];
+            if (!array_intersect([Role::ROLE_ID_SUB_EDITOR, Role::ROLE_ID_ASSISTANT, Role::ROLE_ID_AUTHOR], $stageRoles)) {
+                return false;
+            }
+        }
+
+        // PublicationCanBeEditedPolicy
+        return $isSiteAdmin || $this->canEditPublication($publication, $user);
+    }
+
