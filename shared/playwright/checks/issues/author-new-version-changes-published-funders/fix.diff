+<?php
+
+/**
+ * @file classes/security/authorization/internal/SubmissionPublicationsCanBeEditedPolicy.php
+ *
+ * Copyright (c) 2026 Simon Fraser University
+ * Copyright (c) 2026 John Willinsky
+ * Distributed under the GNU GPL v3. For full terms see the file docs/COPYING.
+ *
+ * @class SubmissionPublicationsCanBeEditedPolicy
+ *
+ * @ingroup security_authorization_internal
+ *
+ * @brief Policy to ensure every publication of the authorized submission is editable by the
+ *  given user, for data that belongs to the submission and shows on every version (funders).
+ */
+
+namespace PKP\security\authorization\internal;
+
+use APP\core\Application;
+use APP\core\Request;
+use APP\facades\Repo;
+use APP\submission\Submission;
+use PKP\security\authorization\AuthorizationPolicy;
+use PKP\security\Role;
+
+class SubmissionPublicationsCanBeEditedPolicy extends AuthorizationPolicy
+{
+    /** @var \PKP\user\User */
+    private $_currentUser;
+
+    public function __construct(Request $request, string $message)
+    {
+        parent::__construct($message);
+        $this->_currentUser = $request->getUser();
+    }
+
+    /**
+     * @see AuthorizationPolicy::effect()
+     */
+    public function effect(): int
+    {
+        $userRoles = $this->getAuthorizedContextObject(Application::ASSOC_TYPE_USER_ROLES);
+        if (in_array(Role::ROLE_ID_SITE_ADMIN, $userRoles)) {
+            return AuthorizationPolicy::AUTHORIZATION_PERMIT;
+        }
+
+        $submission = $this->getAuthorizedContextObject(Application::ASSOC_TYPE_SUBMISSION); /** @var Submission $submission */
+        foreach ($submission->getData('publications') as $publication) {
+            if (!Repo::submission()->canEditPublication($publication, $this->_currentUser)) {
+                return AuthorizationPolicy::AUTHORIZATION_DENY;
+            }
+        }
+
+        return AuthorizationPolicy::AUTHORIZATION_PERMIT;
+    }
+}
