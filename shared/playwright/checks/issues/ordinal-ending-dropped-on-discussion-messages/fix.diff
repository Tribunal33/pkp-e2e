+function getEnglishOrdinalSuffix(dateTime) {
+	// An invalid DateTime has no locale; toFormat() prints "Invalid DateTime" for it
+	if (!dateTime.isValid || dateTime.locale.split('-')[0] !== 'en') {
+		return '';
+	}
