+ *
+ * @class I13207_OrcidEmailTemplateNames
+ *
+ * @brief Give the default ORCID email templates the names of their locale strings.
+ *
+ * The three templates were installed with the code names "orcidCollectAuthorId",
+ * "orcidRequestAuthorAuthorization" and "orcidRequestUpdateScope" that the locale
+ * files carried, and a default template's name is stored once, at install.
+ * Idempotent: listed for 3.5.0-x and for the 3.6 upgrade.
+ *
+ * See pkp/pkp-lib#13207.
+ */
+
+namespace PKP\migration\upgrade\v3_5_0;
+
+use Illuminate\Support\Facades\DB;
+use PKP\facades\Locale;
+use PKP\migration\Migration;
+
+class I13207_OrcidEmailTemplateNames extends Migration
+{
+    protected const NAMES = [
+        'ORCID_COLLECT_AUTHOR_ID' => 'orcid.orcidCollectAuthorId.name',
+        'ORCID_REQUEST_AUTHOR_AUTHORIZATION' => 'orcid.orcidRequestAuthorAuthorization.name',
+        'ORCID_REQUEST_UPDATE_SCOPE' => 'orcid.orcidRequestUpdateScope.name',
+    ];
+
+    public function up(): void
+    {
+        $previous = Locale::getMissingKeyHandler();
+        Locale::setMissingKeyHandler(fn (string $key): string => '');
+
+        $rows = DB::table('email_templates_default_data')
+            ->whereIn('email_key', array_keys(static::NAMES))
+            ->get(['email_key', 'locale']);
+
+        foreach ($rows as $row) {
+            $name = __(static::NAMES[$row->email_key], [], $row->locale);
+            if ($name === '') {
+                continue;
+            }
+            DB::table('email_templates_default_data')
+                ->where('email_key', $row->email_key)
+                ->where('locale', $row->locale)
+                ->update(['name' => $name]);
+        }
+
+        Locale::setMissingKeyHandler($previous);
+    }
+
+    public function down(): void
+    {
+        // Nothing to restore: the old names were the code names.
+    }
+}
