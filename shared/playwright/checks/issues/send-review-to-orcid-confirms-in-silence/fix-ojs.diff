--- a/classes/orcid/actions/SendReviewToOrcid.php
+++ b/classes/orcid/actions/SendReviewToOrcid.php
@@ -18,12 +18,53 @@
 use APP\facades\Repo;
 use APP\jobs\orcid\DepositOrcidReview;
 use APP\jobs\orcid\ReconcileOrcidReviewPutCode;
+use Carbon\Carbon;
 use Illuminate\Support\Facades\Bus;
 use PKP\context\Context;
 use PKP\orcid\actions\PKPSendReviewToOrcid;
+use PKP\orcid\OrcidManager;
+use PKP\submission\reviewAssignment\ReviewAssignment;
 
 class SendReviewToOrcid extends PKPSendReviewToOrcid
 {
+    /**
+     * @inheritDoc
+     *
+     * What DepositOrcidReview::handle() needs before it sends anything or asks the reviewer for permission.
+     */
+    public function getUnavailableReason(): ?string
+    {
+        $review = Repo::reviewAssignment()->get($this->reviewAssignmentId);
+        if (!$review || !in_array($review->getStatus(), ReviewAssignment::REVIEW_COMPLETE_STATUSES)) {
+            return __('orcid.review.send.incomplete');
+        }
+
+        $context = Application::getContextDAO()->getById(
+            Repo::submission()->get($review->getSubmissionId())->getData('contextId')
+        ); /** @var Context $context */
+        if (!OrcidManager::isEnabled($context)) {
+            return __('orcid.review.send.orcidOff');
+        }
+        if (!OrcidManager::canDepositReviews($context)) {
+            return __('orcid.review.send.notConfigured');
+        }
+
+        // Loaded as DepositOrcidReview loads it: a disabled reviewer is not found, and the job would fail.
+        // A reviewer without a token gets nothing; one with the member scope needs it unexpired.
+        // Any other scope is asked for the member scope (SendUpdateScopeMail), which is still an answer.
+        $reviewer = Repo::user()->get($review->getReviewerId());
+        if (
+            !$reviewer?->getOrcid()
+            || !$reviewer->getData('orcidAccessToken')
+            || ($reviewer->getData('orcidAccessScope') === OrcidManager::ORCID_API_SCOPE_MEMBER
+                && !Carbon::parse($reviewer->getData('orcidAccessExpiresOn'))->isFuture())
+        ) {
+            return __('orcid.review.send.notAuthorized');
+        }
+
+        return null;
+    }
+
     /** @inheritDoc */
     public function execute(): void
     {
