+++ b/api/v1/jats/JatsController.php
@@ -0,0 +1,38 @@
+<?php
+
+/**
+ * @file api/v1/jats/JatsController.php
+ *
+ * Copyright (c) 2026 Simon Fraser University
+ * Copyright (c) 2026 John Willinsky
+ * Distributed under the GNU GPL v3. For full terms see the file docs/COPYING.
+ *
+ * @class JatsController
+ *
+ * @ingroup api_v1_jats
+ *
+ * @brief Handle API requests for JATS File operations, with OJS's subscription rules.
+ */
+
+namespace APP\API\v1\jats;
+
+use APP\facades\Repo;
+use APP\issue\IssueAction;
+use PKP\API\v1\jats\PKPJatsController;
+use PKP\publication\PKPPublication;
+use PKP\submission\PKPSubmission;
+
+class JatsController extends PKPJatsController
+{
+    /**
+     * A published version's JATS XML carries the article's text: serve it
+     * to those the article page lets read the full text.
+     */
+    protected function canReadPublished(PKPSubmission $submission, PKPPublication $publication): bool
+    {
+        $request = $this->getRequest();
+        $issueId = $publication->getData('issueId');
+        $issue = $issueId ? Repo::issue()->get((int) $issueId) : null;
+        return (new IssueAction())->userCanReadArticle($request, $request->getContext(), $issue, $submission, $publication);
+    }
+}
