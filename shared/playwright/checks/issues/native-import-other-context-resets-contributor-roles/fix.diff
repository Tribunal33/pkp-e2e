     /**
+     * Find this context's contributor role for a contributor_role element: by
+     * its identifier and, where several roles share one (OMP's "Author" and
+     * "Chapter Author"), by its name in any locale, as user_group_ref was
+     * matched before contributor roles. With no name match, the context's
+     * oldest role with that identifier.
+     */
+    protected function findContributorRole(int $contextId, \DOMElement $node): ?ContributorRole
+    {
+        $candidates = ContributorRole::withContextId($contextId)
+            ->withIdentifier($node->getAttribute('identifier'))
+            ->orderBy('contributor_role_id')
+            ->get();
+        $names = [];
+        foreach ($node->getElementsByTagName('name') as $nameNode) {
+            $names[] = $nameNode->textContent;
+        }
+        return $candidates->first(fn (ContributorRole $role) => count(array_intersect($names, (array) $role->name)) > 0)
+            ?? $candidates->first();
+    }
