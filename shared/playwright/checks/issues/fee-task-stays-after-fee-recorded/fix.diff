     /**
+     * Delete the other queued publication fee payments of the submission
+     * a publication fee payment is fulfilled for, with the authors'
+     * "payment required" tasks (QueuedPaymentDAO::deleteById()).
+     *
+     * A queued payment is stored serialized, so the requests are found
+     * through the tasks RequestPayment::requestPayment() creates for them.
+     */
+    protected function deleteQueuedPublicationPayments(QueuedPayment $fulfilledPayment): void
+    {
+        $queuedPaymentDao = DAORegistry::getDAO('QueuedPaymentDAO'); /** @var QueuedPaymentDAO $queuedPaymentDao */
+        $queuedPaymentIds = Notification::withContextId($fulfilledPayment->getContextId())
+            ->withType(Notification::NOTIFICATION_TYPE_PAYMENT_REQUIRED)
+            ->where('assoc_type', Application::ASSOC_TYPE_QUEUED_PAYMENT)
+            ->pluck('assoc_id')
+            ->unique();
+
+        foreach ($queuedPaymentIds as $queuedPaymentId) {
+            $queuedPayment = $queuedPaymentDao->getById($queuedPaymentId);
+            if (
+                $queuedPayment
+                && $queuedPayment->getType() == self::PAYMENT_TYPE_PUBLICATION
+                && $queuedPayment->getAssocId() == $fulfilledPayment->getAssocId()
+            ) {
+                $queuedPaymentDao->deleteById($queuedPaymentId);
+            }
+        }
+    }
