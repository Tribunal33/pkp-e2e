+    /**
+     * Whether one of the given options has the value `null`
+     *
+     * A field that offers `null` as a choice (a radio's "Do not send an
+     * email.", a select's "None") stores that choice as `null`, so its empty
+     * value must be `null` too: any other value matches no option and the
+     * saved choice shows as unselected.
+     */
+    protected static function offersNullOption(array $options): bool
+    {
+        return collect($options)->contains(
+            fn ($option) => is_array($option) && array_key_exists('value', $option) && $option['value'] === null
+        );
+    }
 }
