--- a/lib/pkp/controllers/grid/settings/roles/UserGroupGridHandler.php
+++ b/lib/pkp/controllers/grid/settings/roles/UserGroupGridHandler.php
@@ -206,7 +206,11 @@
         $totalCount = $builder->count();
         $offset = ($page - 1) * $perPage;
 
-        $pageResults = $builder->offset($offset)
+        // A fixed order, so that a saved or new role keeps its place and each page
