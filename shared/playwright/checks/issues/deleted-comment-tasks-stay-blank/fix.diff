+    /**
+     * Delete the moderators' notifications about these comments, about their
+     * reports and about the other reports given.
+     *
+     * Call it before the rows are deleted. A comment or a report deleted with
+     * its publication or its writer's account goes by database cascade, which
+     * cannot reach the notifications: they point at it by assoc_type and
+     * assoc_id only.
+     *
+     * @param int[] $commentIds
+     * @param int[] $reportIds
+     */
+    public static function deleteNotifications(array $commentIds, array $reportIds = []): void
+    {
+        if (!empty($commentIds)) {
+            $reportIds = array_merge(
+                $reportIds,
+                UserCommentReport::withCommentIds($commentIds)->pluck('user_comment_report_id')->all()
+            );
+            Notification::where('assoc_type', Application::ASSOC_TYPE_COMMENT)
+                ->whereIn('assoc_id', $commentIds)
+                ->delete();
+        }
+        if (!empty($reportIds)) {
+            Notification::where('assoc_type', Application::ASSOC_TYPE_COMMENT_REPORT)
+                ->whereIn('assoc_id', array_unique($reportIds))
+                ->delete();
+        }
+    }
