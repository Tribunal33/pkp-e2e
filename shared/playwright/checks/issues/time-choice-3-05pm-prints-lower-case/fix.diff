+import {describe, test, expect} from 'vitest';
+import {DateTime} from 'luxon';
+import {formatDateWithPhpFormat} from './dateUtils';
+
+describe('formatDateWithPhpFormat', () => {
+	const afternoon = DateTime.fromISO('2026-09-24T15:05:00');
+
+	test('a prints the lowercase meridiem, A the uppercase one, as PHP does', () => {
+		expect(formatDateWithPhpFormat(afternoon, 'g:ia')).toBe('3:05pm');
+		expect(formatDateWithPhpFormat(afternoon, 'h:i A')).toBe('03:05 PM');
+		expect(formatDateWithPhpFormat(afternoon, 'Y-m-d g:ia')).toBe(
+			'2026-09-24 3:05pm',
+		);
+		expect(formatDateWithPhpFormat(afternoon, 'H:i')).toBe('15:05');
+	});
+
+	test('an escaped a stays the letter', () => {
+		expect(formatDateWithPhpFormat(afternoon, 'g:i \\a')).toBe('3:05 a');
+	});
+});
