     /**
+     * The ROR ID and name to store with a funder. A registry-backed funder takes its name
+     * from the ROR cache. When the cache does not hold the ROR record (ror.org could not be
+     * reached), a funder sent with a name is kept as a typed name, without a ROR ID the
+     * server has not verified.
+     *
+     * @return array [?string $ror, mixed $name]
+     */
+    protected function getRorAndName(?string $ror, mixed $name): array
+    {
+        if (!$ror) {
+            return [null, $name];
+        }
+        if (Repo::ror()->getByRor($ror) !== null || empty(array_filter((array) $name))) {
+            return [$ror, []];
+        }
+        return [null, $name];
+    }
