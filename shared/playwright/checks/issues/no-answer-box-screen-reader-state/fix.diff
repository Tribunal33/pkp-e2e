 const emit = defineEmits(['change']);
 
 const icon = computed(() => (props.checked ? 'CheckboxTicked' : 'Checkbox'));
+
+/**
+ * The browser has already toggled the input. Put it back on `checked`, which
+ * the icon is drawn from, so that a screen reader hears what the eye sees: a
+ * parent that accepts the change (at once, or after a confirmation) changes
+ * `checked`, and the input follows it then.
+ */
+function onChange(event) {
+	emit('change', event);
+	event.target.checked = props.checked;
+}
 </script>
