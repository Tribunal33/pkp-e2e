     /**
+     * Get the journal's institution that has exactly this name and these IP ranges, if one
+     * exists, so that buying again for the same institution does not add a copy of it.
+     * An institution that differs in anything is never reused, so a purchase changes no
+     * existing institution.
+     */
+    protected function getMatchingInstitutionId(int $journalId, string $name, array $ipRanges): ?int
+    {
+        $normalize = fn (array $ranges) => collect($ranges)->map(fn ($range) => trim($range))->filter()->sort()->values()->all();
+        $ipRanges = $normalize($ipRanges);
+        $locale = Locale::getLocale();
+        $institutions = Repo::institution()->getCollector()
+            ->filterByContextIds([$journalId])
+            ->getMany();
+        foreach ($institutions as $institution) {
+            if (trim((string) $institution->getName($locale)) === trim($name) && $normalize($institution->getIPRanges()) === $ipRanges) {
+                return $institution->getId();
+            }
+        }
+        return null;
+    }
+
