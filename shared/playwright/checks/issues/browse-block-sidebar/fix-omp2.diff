+
+    /**
+     * A category and its sub-categories, at every depth, as the template lists them.
+     */
+    private function formatCategoryData(Category $category): array
+    {
+        // Avoid processing the same category multiple times (left out of the list)
+        if (in_array($category->getId(), $this->processedCategoryIds)) {
+            return [];
+        }
+        $this->processedCategoryIds[] = $category->getId();
+
+        $children = Repo::category()->getCollector()
+            ->filterByContextIds([$category->getContextId()])
+            ->filterByParentIds([$category->getId()])
+            ->getMany();
+
+        return [
+            'id' => $category->getId(),
+            'path' => $category->getPath(),
+            'parentId' => $category->getParentId(),
+            'localizedTitle' => $category->getLocalizedTitle(),
+            'subCategories' => $children->map(fn (Category $child) => $this->formatCategoryData($child))->filter()->all(),
+        ];
+    }
 }
