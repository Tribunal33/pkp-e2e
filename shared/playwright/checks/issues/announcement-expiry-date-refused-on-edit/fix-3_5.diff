 /**
+ * Formats a date as YYYY-MM-DD in the install's time zone, whatever the
+ * context's display formats: the shape the API's date fields accept
+ * (`date_format:Y-m-d`), for a form field that sends the value back.
+ * @param {string | Date} dateString - The date string (ISO 8601 as the API sends it) or Date object.
+ * @returns {string} The date as YYYY-MM-DD, or an empty string if dateString is falsy.
+ */
+export function formatIsoDate(dateString) {
+	if (!dateString) {
+		return '';
+	}
+	return parseDateTimeString(dateString)
+		.setZone(getConfiguredTimezone())
+		.toISODate();
+}
