+ *
+ * @class I5962_ManagerRoleStages
+ *
+ * @brief Give every workflow stage to the manager-level user groups that hold none.
+ *
+ * All stages are always active for the manager permission level
+ * (RoleDAO::getAlwaysActiveStages(), pkp/pkp-lib#2849), but the journal and
+ * press manager groups were installed without a stage.
+ */
+
+namespace PKP\migration\upgrade\v3_6_0;
+
+use APP\core\Application;
+use Illuminate\Support\Facades\DB;
+use PKP\install\DowngradeNotSupportedException;
+use PKP\migration\Migration;
+use PKP\security\Role;
+
+class I5962_ManagerRoleStages extends Migration
+{
+    /**
+     * @inheritDoc
+     */
+    public function up(): void
+    {
+        $workflowStageIds = Application::getApplicationStages();
+
+        $userGroups = DB::table('user_groups as ug')
+            ->where('ug.role_id', Role::ROLE_ID_MANAGER)
+            ->whereNotExists(
+                fn ($query) => $query->select(DB::raw(1))
+                    ->from('user_group_stage as ugs')
+                    ->whereColumn('ugs.user_group_id', 'ug.user_group_id')
+                    ->whereIn('ugs.stage_id', $workflowStageIds)
+            )
+            ->get(['ug.user_group_id', 'ug.context_id']);
+
+        foreach ($userGroups as $userGroup) {
+            foreach (array_merge($workflowStageIds, [WORKFLOW_STAGE_ID_DONE]) as $stageId) {
+                DB::table('user_group_stage')->insertOrIgnore([
+                    'context_id' => $userGroup->context_id,
+                    'user_group_id' => $userGroup->user_group_id,
+                    'stage_id' => $stageId,
+                ]);
+            }
+        }
+    }
+
+    /**
+     * @inheritDoc
+     */
+    public function down(): void
+    {
+        throw new DowngradeNotSupportedException();
+    }
+}
