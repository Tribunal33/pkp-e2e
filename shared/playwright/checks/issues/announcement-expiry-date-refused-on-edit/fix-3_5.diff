+describe('formatIsoDate', () => {
+	const {formatIsoDate} = useDate();
+	const browserZone = Settings.defaultZone;
+	afterEach(() => {
+		Settings.defaultZone = browserZone;
+		global.pkp.context.timeZone = 'UTC';
+		delete global.pkp.context.dateFormatShort;
+	});
+	test('keeps the stored date in a browser west of the install', () => {
+		Settings.defaultZone = 'America/New_York';
+		global.pkp.context.timeZone = 'UTC';
+		expect(formatIsoDate('2027-03-31T00:00:00.000000Z')).toBe('2027-03-31');
+	});
+	test('reads the date in the install time zone', () => {
+		Settings.defaultZone = 'UTC';
+		global.pkp.context.timeZone = 'Europe/Prague';
+		expect(formatIsoDate('2027-03-30T22:00:00.000000Z')).toBe('2027-03-31');
+	});
+	test('ignores the display format', () => {
+		global.pkp.context.dateFormatShort = 'd-m-Y';
+		expect(formatIsoDate('2027-03-31T00:00:00.000000Z')).toBe('2027-03-31');
+	});
+});
