     /**
+     * Label one entry of a list of months or weeks: the count 1 takes its own
+     * string where the current locale translates it, and every other count (or a
+     * locale without that string yet) takes the counted one.
+     *
+     * @param int $count The entry's count
+     * @param string $oneKey The locale key for the count 1 ("1 Month")
+     * @param string $countKey The locale key for any count ("{$x} Months")
+     */
+    public static function getCountLabel(int $count, string $oneKey, string $countKey): string
+    {
+        if ($count === 1 && ($one = Locale::getBundle()->translateSingular($oneKey))) {
+            return $one;
+        }
+        return __($countKey, ['x' => $count]);
+    }
