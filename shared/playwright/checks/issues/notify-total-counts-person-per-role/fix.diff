+
+    /**
+     * Get the number of users a bulk email to one or more user groups would
+     * be sent to: each user once, however many of the groups they hold, and
+     * the current user when a copy is requested
+     */
+    public function getRecipientCount(Request $illuminateRequest): JsonResponse
+    {
+        $context = $this->getRequest()->getContext();
+
+        if (!in_array($context->getId(), (array) $this->getRequest()->getSite()->getData('enableBulkEmails'))) {
+            return response()->json([
+                'error' => __('api.emails.403.disabled'),
+            ], Response::HTTP_FORBIDDEN);
+        }
+
+        $params = $this->getParams($illuminateRequest);
+
+        if (empty($params['userGroupIds'])) {
+            return response()->json(['total' => 0], Response::HTTP_OK);
+        }
+
+        if (!$this->canSendTo($context, $params['userGroupIds'])) {
+            return response()->json([
+                'userGroupIds' => [__('api.emails.403.notAllowedUserGroup')],
+            ], Response::HTTP_BAD_REQUEST);
+        }
+
+        return response()->json([
+            'total' => count($this->getRecipientIds($context->getId(), $params)),
+        ], Response::HTTP_OK);
+    }
+
+    /**
+     * Read the bulk email params from the request
+     */
+    protected function getParams(Request $illuminateRequest): array
+    {
+        $params = [];
+        foreach ($illuminateRequest->input() as $param => $val) {
+            switch ($param) {
+                case 'userGroupIds':
+                    if (!is_array($val)) {
+                        $val = strlen(trim($val))
+                            ? explode(',', $val)
+                            : [];
+                    }
+                    $params[$param] = array_map(intval(...), $val);
+                    break;
+                case 'body':
+                case 'subject':
+                    $params[$param] = $val;
+                    break;
+                case 'copy':
+                    $params[$param] = (bool) $val;
+                    break;
+            }
+        }
+
+        return $params;
+    }
+
+    /**
+     * Whether every user group belongs to the context and may receive a bulk email
+     */
+    protected function canSendTo(Context $context, array $userGroupIds): bool
+    {
+        foreach ($userGroupIds as $userGroupId) {
+            if (!Repo::userGroup()->contextHasGroup($context->getId(), $userGroupId)
+                    || in_array($userGroupId, (array) $context->getData('disableBulkEmailUserGroups'))) {
+                return false;
+            }
+        }
+
+        return true;
+    }
+
+    /**
+     * Get the ids of the users a bulk email is sent to: the active members of
+     * the user groups, each once, and the current user when a copy is requested
+     */
+    protected function getRecipientIds(int $contextId, array $params): array
+    {
+        $userIds = Repo::user()->getCollector()
+            ->filterByContextIds([$contextId])
+            ->filterByUserGroupIds($params['userGroupIds'])
+            ->getIds()
+            ->toArray();
+
+        if (!empty($params['copy'])) {
+            $currentUserId = $this->getRequest()->getUser()->getId();
+            if (!in_array($currentUserId, $userIds)) {
+                $userIds[] = $currentUserId;
+            }
+        }
+
+        return $userIds;
+    }
 }
