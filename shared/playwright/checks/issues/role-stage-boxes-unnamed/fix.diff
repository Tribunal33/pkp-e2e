     /**
+     * The row's name as plain text, for the cell templates that name their
+     * control after the row (selectStatusCell.tpl, radioButtonCell.tpl):
+     * the label of the column flagged 'firstColumn' (setFirstDataColumn()).
+     * Null when the grid has no column drawn with those templates.
+     *
+     * @param \PKP\controllers\grid\GridRow $row
+     */
+    protected function getRowLabel($row): ?string
+    {
+        $columns = $this->getColumns();
+        $templates = array_map(fn (GridColumn $column) => $column->getTemplate(), $columns);
+        if (!array_intersect($templates, self::ROW_NAMED_CELL_TEMPLATES) || $row->getData() === null) {
+            return null;
+        }
+        foreach ($columns as $column) {
+            if (!$column->hasFlag('firstColumn')) {
+                continue;
+            }
+            $cellProvider = $row->getCellProvider();
+            if (!$cellProvider instanceof GridCellProvider) {
+                $cellProvider = $column->getCellProvider();
+            }
+            $label = $cellProvider->getTemplateVarsFromRowColumn($row, $column)['label'] ?? null;
+            if (is_array($label)) { // A multilingual column
+                $label = $label[Locale::getLocale()] ?? reset($label);
+            }
+            return is_string($label) ? trim(strip_tags($label)) : null;
+        }
+        return null;
+    }
