 msgid "emails.submissionAck.body"
 msgstr ""
+"<p>{$recipientName},</p><p>Nous vous remercions de votre soumission à "
+"{$contextName}. Nous avons bien reçu votre prépublication, {$submissionTitle}, "
+"et un-e modérateur-trice en prendra connaissance sous peu. Une fois votre "
+"soumission examinée, il ou elle publiera votre prépublication ou "
+"communiquera avec vous.</p><p>Vous pouvez consulter votre soumission et "
+"suivre sa progression dans le processus éditorial à l'adresse suivante :</"
+"p><p>URL de la soumission : <a href=\"{$authorSubmissionUrl}\">{$authorSubmissionUrl}</a></p><p>Si "
+"vous avez été déconnecté-e, vous pouvez ouvrir une nouvelle session avec le "
+"nom d'utilisateur-trice {$recipientUsername}.</p><p>Si vous avez des "
+"questions, n'hésitez pas à communiquer avec moi à partir de votre <a "
+"href=\"{$authorSubmissionUrl}\">tableau de bord de soumission</a>.</"
+"p><p>Nous vous remercions d'avoir pensé à {$contextName} pour la diffusion "
+"de vos travaux.</p>{$contextSignature}"
 
