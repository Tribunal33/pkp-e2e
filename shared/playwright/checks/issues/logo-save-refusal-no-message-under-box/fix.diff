+    /**
+     * Validate that a new image upload is one the file store will accept
+     *
+     * The rule PKPContextService::moveTemporaryFile() applies to an image, checked
+     * here so that a refused file is reported, under its locale, before any file
+     * of the same save is moved. A missing temporary file is left to
+     * temporaryFilesExist().
+     *
+     * @param \Illuminate\Validation\Validator $validator
+     * @param array $imageProps List of prop names that hold an image upload
+     * @param array $multilingualImageProps List of $imageProps which are multilingual
+     * @param array $props Key/value list of props
+     * @param array $allowedLocales List of locale codes
+     * @param ?int $userId The user who uploaded the temporary files
+     */
+    public static function temporaryFilesAreImages($validator, $imageProps, $multilingualImageProps, $props, $allowedLocales, $userId)
+    {
+        $validator->after(function ($validator) use ($imageProps, $multilingualImageProps, $props, $allowedLocales, $userId) {
+            $temporaryFileManager = new TemporaryFileManager();
+            $check = function (string $errorKey, $value) use ($validator, $temporaryFileManager, $userId) {
+                if (!isset($value['temporaryFileId']) || $validator->errors()->get($errorKey)) {
+                    return;
+                }
+                $temporaryFile = $temporaryFileManager->getFile((int) $value['temporaryFileId'], $userId);
+                if (
+                    $temporaryFile
+                    && (!$temporaryFileManager->getImageExtension($temporaryFile->getFileType()) || !$temporaryFileManager->isValidImage($temporaryFile))
+                ) {
+                    $validator->errors()->add($errorKey, __('api.400.errorUploadingImage'));
+                }
+            };
+            foreach ($imageProps as $imageProp) {
+                if (!isset($props[$imageProp])) {
+                    continue;
+                }
+                if (in_array($imageProp, $multilingualImageProps)) {
+                    foreach ($allowedLocales as $localeKey) {
+                        $check($imageProp . '.' . $localeKey, $props[$imageProp][$localeKey] ?? null);
+                    }
+                } else {
+                    $check($imageProp, $props[$imageProp]);
+                }
+            }
+        });
+    }
 }
