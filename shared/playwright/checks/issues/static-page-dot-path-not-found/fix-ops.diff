     /**
+     * Get the path requested in the URL: the page, the operation (left out when it
+     * is "index" or empty, as getRequestedOp() reads it) and the arguments, joined
+     * with "/" as they were requested. For looking up content stored under a path
+     * (custom pages, static pages): getRequestedPage() and getRequestedOp() remove
+     * every character a handler name may not hold, "." included.
+     */
+    public function getRequestedPath(PKPRequest $request): string
+    {
+        $parts = $this->_getRequestedUrlParts(Core::getPathParts(...), $request);
+        if (in_array($parts[1] ?? null, ['', 'index'], true)) {
+            unset($parts[1]);
+        }
+        return implode('/', $parts);
+    }
