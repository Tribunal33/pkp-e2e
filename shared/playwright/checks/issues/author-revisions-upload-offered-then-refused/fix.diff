+// Whether the server takes a revision file from the author on this round, as
+// far as the round's status tells (SubmissionFileStageAccessPolicy): once
+// revisions were requested, or once the round was accepted
+function canAuthorUploadRevisions({stageId, reviewRound}) {
+	return (
+		[
+			pkp.const.REVIEW_ROUND_STATUS_REVISIONS_REQUESTED,
+			pkp.const.REVIEW_ROUND_STATUS_REVISIONS_SUBMITTED,
+			pkp.const.REVIEW_ROUND_STATUS_RESUBMIT_FOR_REVIEW,
+			pkp.const.REVIEW_ROUND_STATUS_RESUBMIT_FOR_REVIEW_SUBMITTED,
+		].includes(reviewRound?.statusId) ||
+		(stageId === pkp.const.WORKFLOW_STAGE_ID_EXTERNAL_REVIEW &&
+			reviewRound?.statusId === pkp.const.REVIEW_ROUND_STATUS_ACCEPTED)
+	);
+}
 
