     /**
+     * The name of the participant's reviewer role: of the reviewer roles assigned to the
+     * stage of their review (a press's Internal Review and External Review each have
+     * their own), the one they hold; else one they hold; else the generic "Reviewer".
+     */
+    protected function getReviewerRoleName(Enumerable $userGroups, Enumerable $reviewAssignments): string
+    {
+        $stageIds = $reviewAssignments
+            ->map(fn (ReviewAssignment $reviewAssignment) => $reviewAssignment->getStageId())
+            ->unique()
+            ->values()
+            ->all();
+
+        $reviewerUserGroups = $userGroups->filter(fn (UserGroup $userGroup) => $userGroup->roleId === Role::ROLE_ID_REVIEWER);
+        $heldUserGroups = $reviewerUserGroups->filter(
+            fn (UserGroup $userGroup) => $userGroup->userUserGroups->contains(fn (UserUserGroup $userUserGroup) => $userUserGroup->userId === $this->userId)
+        );
+        $isOnStage = fn (UserGroup $userGroup) => $userGroup->getAssignedStageIds()->intersect($stageIds)->isNotEmpty();
+
+        $reviewerUserGroup = $heldUserGroups->first($isOnStage)
+            ?? $reviewerUserGroups->first($isOnStage)
+            ?? $heldUserGroups->first();
+
+        return $reviewerUserGroup?->getLocalizedData('name') ?? __('user.role.reviewer');
+    }
