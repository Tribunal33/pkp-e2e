+
+// Panel empty texts. With no item at all, nothing is assigned and nothing can
+// be dragged, so neither "Drag items from Unassigned Menu Items." nor "All items
+// have been assigned." is true: both panels keep MenuTreePanel's own empty text.
+const hasNoItems = computed(
+	() => assignedItems.value.length === 0 && unassignedItems.value.length === 0,
+);
+
+const assignedPanelEmptyMessage = computed(() => {
+	if (hasNoItems.value) {
+		return '';
+	}
+	return (
+		props.assignedEmptyMessage || t('manager.navigationMenu.noAssignedItems')
+	);
+});
+
+const unassignedPanelEmptyMessage = computed(() => {
