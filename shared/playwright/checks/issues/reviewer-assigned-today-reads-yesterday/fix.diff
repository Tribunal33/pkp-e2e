+describe('calculateCalendarDaysBetweenDates', () => {
+	const {calculateCalendarDaysBetweenDates} = useDate();
+	test('the same day is 0 days, whatever the hours', () => {
+		expect(
+			calculateCalendarDaysBetweenDates(
+				'2025-02-20 00:10:27',
+				'2025-02-20 23:00:00',
+			),
+		).toBe(0);
+	});
+	test('the day before is 1 day, also less than 24 hours earlier', () => {
+		expect(
+			calculateCalendarDaysBetweenDates(
+				'2025-02-19 23:10:27',
+				'2025-02-20 08:00:00',
+			),
+		).toBe(1);
+		expect(
+			calculateCalendarDaysBetweenDates(
+				'2025-02-19 08:10:27',
+				'2025-02-20 23:00:00',
+			),
+		).toBe(1);
+	});
+	test('two days before is 2 days', () => {
+		expect(
+			calculateCalendarDaysBetweenDates(
+				'2025-02-18 23:59:00',
+				'2025-02-20 00:01:00',
+			),
+		).toBe(2);
+	});
+});
