+    /**
+     * Whether the context's ORCID settings let a review be deposited: ORCID on, a member API,
+     * and the city and country a review deposit names.
+     */
+    public static function canDepositReviews(Context $context): bool
+    {
+        return self::isEnabled($context)
+            && self::isMemberApiEnabled($context)
+            && self::getCity($context) !== ''
+            && self::getCountry($context) !== '';
     }
 
 
