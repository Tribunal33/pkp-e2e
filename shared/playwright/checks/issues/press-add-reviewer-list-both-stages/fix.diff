+    /**
+     * Check if a user holds a reviewer role of the context that serves the given workflow stage
+     * (a press's Internal Reviewers for its internal review, its External Reviewers for its external review).
+     */
+    protected function isReviewerForStage(int $contextId, int $stageId, int $reviewerId): bool
+    {
+        return Repo::user()->getCollector()
+            ->filterByUserIds([$reviewerId])
+            ->filterByContextIds([$contextId])
+            ->filterByRoleIds([Role::ROLE_ID_REVIEWER])
+            ->filterByWorkflowStageIds([$stageId])
+            ->getCount() > 0;
     }
 
