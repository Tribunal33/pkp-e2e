+
+    /**
+     * Append a title or subtitle stored as HTML to its Crossref element: the formatting the "Title" and
+     * "Subtitle" boxes save (bold, italic, underline, superscript, subscript) as Crossref's face markup,
+     * which the schema accepts in these elements, and everything else as text with its HTML entities
+     * decoded. A title stored with a bare "&" (from before titles were HTML) reads the same.
+     */
+    public function appendFaceMarkup(DOMDocument $doc, DOMElement $node, string $html): void
+    {
+        $source = new DOMDocument();
+        if (!@$source->loadHTML('<?xml encoding="utf-8"?><body>' . $html . '</body>', LIBXML_NONET)) {
+            $node->appendChild($doc->createTextNode(html_entity_decode(strip_tags($html), ENT_QUOTES | ENT_HTML5, 'UTF-8')));
+            return;
+        }
+        $this->copyFaceMarkup($doc, $node, $source->getElementsByTagName('body')->item(0));
+    }
+
+    /**
+     * Copy an HTML node's content into a Crossref element: the face markup elements kept, other
+     * elements reduced to their content.
+     */
+    protected function copyFaceMarkup(DOMDocument $doc, DOMElement $target, DOMNode $source): void
+    {
+        $faces = ['b' => 'b', 'strong' => 'b', 'i' => 'i', 'em' => 'i', 'u' => 'u', 'sup' => 'sup', 'sub' => 'sub'];
+        foreach ($source->childNodes as $child) {
+            if ($child instanceof DOMText) {
+                $target->appendChild($doc->createTextNode($child->data));
+            } elseif ($child instanceof DOMElement) {
+                $face = $faces[strtolower($child->localName)] ?? null;
+                $into = $face ? $target->appendChild($doc->createElementNS($this->getDeployment()->getNamespace(), $face)) : $target;
+                $this->copyFaceMarkup($doc, $into, $child);
+            }
+        }
+    }
 }
