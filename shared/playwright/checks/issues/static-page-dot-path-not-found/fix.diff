     /**
+     * Get the page, operation and arguments requested in the URL as one path,
+     * the way custom pages and static pages store theirs: joined by "/", an
+     * "index" operation left out, nothing cleaned. Serves lookups by stored
+     * path only; getRequestedPage() and getRequestedOp() name handler files.
+     */
+    public function getRequestedPagePath(PKPRequest $request): string
+    {
+        $parts = $this->_getRequestedUrlParts(Core::getPathParts(...), $request);
+        if (in_array($parts[1] ?? null, ['', 'index'], true)) {
+            unset($parts[1]);
+        }
+        return implode('/', $parts);
+    }
