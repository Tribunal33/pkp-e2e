+ *
+ * @class I11515_ManagerLevelRolesEveryStage
+ *
+ * @brief Give every Journal Manager-level user group every stage, as
+ *  UserGroupForm::execute() does when such a role is saved (pkp/pkp-lib#2849).
+ */
+
+namespace PKP\migration\upgrade\v3_6_0;
+
+use APP\core\Application;
+use Illuminate\Support\Facades\DB;
+use PKP\install\DowngradeNotSupportedException;
+use PKP\migration\Migration;
+use PKP\security\Role;
+
+class I11515_ManagerLevelRolesEveryStage extends Migration
+{
+    /**
+     * @inheritDoc
+     */
+    public function up(): void
+    {
+        $userGroups = DB::table('user_groups')
+            ->where('role_id', Role::ROLE_ID_MANAGER)
+            ->whereNotNull('context_id')
+            ->get(['user_group_id', 'context_id']);
+
+        foreach ($userGroups as $userGroup) {
+            DB::table('user_group_stage')->insertOrIgnore(array_map(
+                fn (int $stageId) => [
+                    'context_id' => $userGroup->context_id,
+                    'user_group_id' => $userGroup->user_group_id,
+                    'stage_id' => $stageId,
+                ],
+                Application::getValidStages()
+            ));
+        }
+    }
+
+    /**
+     * @inheritDoc
+     */
+    public function down(): void
+    {
+        throw new DowngradeNotSupportedException();
+    }
+}
