 /**
+ * Calculates the number of calendar days between two dates, in the configured time zone:
+ * 0 for the same day, 1 for the day before, whatever the hours.
+ * @param {string | Date} _startDate - The start date as a string or Date object.
+ * @param {string | Date} _endDate - The end date as a string or Date object.
+ * @returns {number} The number of calendar days from the start date to the end date.
+ */
+export function calculateCalendarDaysBetweenDates(_startDate, _endDate) {
+	const zone = getConfiguredTimezone();
+	const startDay = parseDateTimeString(_startDate).setZone(zone).startOf('day');
+	const endDay = parseDateTimeString(_endDate).setZone(zone).startOf('day');
+	// + 0 is trick to avoid -0; round, as a day around a DST change is not 24 hours
+	return Math.round(endDay.diff(startDay, 'days').days) + 0;
+}
