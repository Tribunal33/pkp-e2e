+/**
+ * Writes a text as a Luxon format literal: each character quoted, a single quote as ''
+ * @param {string} text
+ * @returns {string}
+ */
+function toLuxonLiteral(text) {
+	return text
+		.split('')
+		.map((char) => (char === "'" ? "''" : `'${char}'`))
+		.join('');
