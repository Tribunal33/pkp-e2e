+<?php
+
+/**
+ * @file jobs/citation/MarksCitationFailed.php
+ *
+ * Copyright (c) 2026 Simon Fraser University
+ * Copyright (c) 2026 John Willinsky
+ * Distributed under the GNU GPL v3. For full terms see the file docs/COPYING.
+ *
+ * @trait MarksCitationFailed
+ *
+ * @ingroup jobs
+ *
+ * @brief failed() for every job of a citation's lookup chain: marks the citation FAILED, so it stops
+ *   counting as a lookup under way, and logs the stage the lookup stopped at.
+ */
+
+namespace PKP\jobs\citation;
+
+use APP\facades\Repo;
+use Illuminate\Support\Facades\Log;
+use PKP\citation\enum\CitationProcessingStatus;
+use Throwable;
+
+trait MarksCitationFailed
+{
+    /**
+     * Called by the queue when this job is abandoned.
+     */
+    public function failed(Throwable $e): void
+    {
+        $this->markCitationFailed($e);
+    }
+
+    /**
+     * Mark the citation FAILED and log the failure, with the status it had reached.
+     */
+    protected function markCitationFailed(Throwable $e, array $logContext = []): void
+    {
+        $citation = Repo::citation()->get($this->citationId);
+        $lastProcessingStatus = null;
+        if ($citation) {
+            $lastProcessingStatus = $citation->getData('processingStatus');
+            $citation->setProcessingStatus(CitationProcessingStatus::FAILED->value);
+            Repo::citation()->edit($citation, []);
+        }
+
+        Log::error('Citation metadata lookup abandoned', [
+            'job' => static::class,
+            'contextId' => $this->contextId,
+            'citationId' => $this->citationId,
+            'publicationId' => $citation?->getData('publicationId'),
+            'lastProcessingStatus' => $lastProcessingStatus,
+            ...$logContext,
+            'attempts' => $this->attempts(),
+            'reason' => $e->getMessage(),
+        ]);
+    }
+}
