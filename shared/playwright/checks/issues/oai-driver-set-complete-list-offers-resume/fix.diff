+    /**
+     * The OAI records of the DRIVER set: the rule of DRIVERPlugin::isDRIVERRecord()
+     * applied to the rows of OAIDAO::getRecordsRecordSetQuery().
+     */
+    public function getDRIVERRecordsQuery(array $setIds, ?int $from, ?int $until): Builder
+    {
+        $journalSetting = fn (string $name, callable $value) => fn (Builder $q) => $value(
+            $q->from('journal_settings AS js')
+                ->whereColumn('js.journal_id', 'r.journal_id')
+                ->where('js.setting_name', '=', $name)
+        );
+        $issueAccess = fn (array $statuses) => fn (Builder $q) => $q->from('issues AS di')
+            ->whereColumn('di.issue_id', 'r.issue_id')
+            ->whereIn('di.access_status', $statuses);
+
+        return DB::query()
+            ->fromSub($this->getRecordsRecordSetQuery($setIds, $from, $until, null), 'r')
+            ->where(fn (Builder $q) => $q
+                // A deleted record: its tombstone was marked when the article was withdrawn.
+                ->whereExists(fn (Builder $q) => $q->from('data_object_tombstone_settings AS dts')
+                    ->whereColumn('dts.tombstone_id', 'r.tombstone_id')
+                    ->where('dts.setting_name', '=', 'driver')
+                    ->where('dts.setting_value', '=', '1'))
+                // A live record: anyone may read the article, and it has a galley.
+                ->orWhere(fn (Builder $q) => $q
+                    ->whereNull('r.tombstone_id')
+                    ->whereExists(fn (Builder $q) => $q->from('publication_galleys AS dg')
+                        ->whereColumn('dg.publication_id', 'r.publication_id'))
+                    ->whereNotExists($journalSetting('restrictSiteAccess', fn ($q) => $q->where('js.setting_value', '=', '1')))
+                    ->whereNotExists($journalSetting('restrictArticleAccess', fn ($q) => $q->where('js.setting_value', '=', '1')))
+                    ->where(fn (Builder $q) => $q
+                        // an open access journal (no publishing mode stored reads as open)
+                        ->whereNotExists($journalSetting('publishingMode', fn ($q) => $q->where('js.setting_value', '<>', (string) Journal::PUBLISHING_MODE_OPEN)))
+                        // a subscription journal: an open issue, or an article marked open outside a subscription issue
+                        ->orWhere(fn (Builder $q) => $q
+                            ->whereExists($journalSetting('publishingMode', fn ($q) => $q->where('js.setting_value', '=', (string) Journal::PUBLISHING_MODE_SUBSCRIPTION)))
+                            ->where(fn (Builder $q) => $q
+                                ->whereExists($issueAccess([0, Issue::ISSUE_ACCESS_OPEN]))
+                                ->orWhere(fn (Builder $q) => $q
+                                    ->where(fn (Builder $q) => $q
+                                        ->whereNull('r.issue_id')
+                                        ->orWhereExists($issueAccess([Issue::ISSUE_ACCESS_SUBSCRIPTION])))
+                                    ->whereExists(fn (Builder $q) => $q->from('publications AS dp')
+                                        ->whereColumn('dp.publication_id', 'r.publication_id')
+                                        ->where('dp.access_status', '=', Submission::ARTICLE_ACCESS_OPEN))))))))
+            ->orderBy('r.journal_id')
+            ->orderBy('r.submission_id')
+            ->orderBy('r.publication_id')
+            ->orderBy('r.tombstone_id');
+    }
 }
