 	/**
+	 * Say why nothing happens when the image window's "Upload" tab is given
+	 * only files whose names do not end in one of the editor's
+	 * images_file_types: TinyMCE 7 drops them without a word. TinyMCE 8.4
+	 * shows this same message itself (TINY-13420); remove this with that
+	 * upgrade.
+	 * @param {Object} editor The TinyMCE editor.
+	 */
+	$.pkp.controllers.SiteHandler.prototype.alertOnSkippedImages =
+			function(editor) {
+		var openWindows = 0,
+				onFiles = function(event) {
+					var files = event.type === 'drop' ?
+							event.dataTransfer && event.dataTransfer.files :
+							event.target.files,
+							types = editor.options.get('images_file_types').split(',');
+
+					if (!openWindows || !files || !files.length ||
+							!$(event.target).closest('.tox-dropzone-container').length) {
+						return;
+					}
+					if (!Array.prototype.some.call(files, function(file) {
+						return types.some(function(type) {
+							return file.name.toLowerCase().endsWith(
+									'.' + $.trim(type).toLowerCase());
+						});
+					})) {
+						editor.windowManager.alert(
+								'Selected images do not have allowed extensions');
+					}
+				};
+
+		editor.on('OpenWindow', function() {
+			if (!openWindows++) {
+				document.addEventListener('change', onFiles, true);
+				document.addEventListener('drop', onFiles, true);
+			}
+		});
+		editor.on('CloseWindow', function() {
+			if (!--openWindows) {
+				document.removeEventListener('change', onFiles, true);
+				document.removeEventListener('drop', onFiles, true);
+			}
+		});
+	};
