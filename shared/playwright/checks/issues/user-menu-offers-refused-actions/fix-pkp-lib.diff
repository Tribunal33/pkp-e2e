+    /**
+     * Determine if the current user can disable or enable the target user's account:
+     * UserGridHandler::disableUser() asks for Validation::ADMINISTRATION_FULL. A manager's
+     * permissionMap already answers false for a site administrator; a site administrator's
+     * map answers true for everyone, so site administrators are left out here.
+     */
+    protected function getPropertyCanDisable(User $user, array $auxiliaryData = []): bool
+    {
+        $currentUserId = $auxiliaryData['currentUserId'] ?? null;
+        $userId = (int) $user->getId();
+        if ($currentUserId === null || (int) $currentUserId === $userId || in_array($userId, $auxiliaryData['siteAdminIds'] ?? [], true)) {
+            return false;
+        }
+
+        return (bool) ($auxiliaryData['permissionMap'][$userId] ?? false);
+    }
+
+    /**
+     * Determine if the current user can remove the target user from the context:
+     * UserGridHandler::removeUser() refuses only Validation::ADMINISTRATION_PROHIBITED,
+     * which, for a manager of the context or a site administrator, is a site administrator.
+     * The current user's own row is left out, as the menu leaves it out.
+     */
+    protected function getPropertyCanRemove(User $user, array $auxiliaryData = []): bool
+    {
+        $currentUserId = $auxiliaryData['currentUserId'] ?? null;
+        $userId = (int) $user->getId();
+
+        return $currentUserId !== null
+            && (int) $currentUserId !== $userId
+            && !in_array($userId, $auxiliaryData['siteAdminIds'] ?? [], true);
+    }
