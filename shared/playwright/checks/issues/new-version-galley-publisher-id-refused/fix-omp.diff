     /**
      * @copydoc PKPPubIdPluginDAO::pubIdExists()
+     *
+     * A new version copies its chapters with their pub ids, and the versions of
+     * one submission may share a pub id, so the chapters of the excluded chapter's
+     * other versions are left out of the check.
      */
     public function pubIdExists(string $pubIdType, string $pubId, int $excludePubObjectId, int $contextId): bool
     {
+        $otherVersions = DB::table('publications AS op')
+            ->join('publications AS ep', 'op.submission_id', '=', 'ep.submission_id')
+            ->join('submission_chapters AS ec', 'ec.publication_id', '=', 'ep.publication_id')
+            ->where('ec.chapter_id', '=', $excludePubObjectId)
+            ->whereColumn('op.publication_id', '<>', 'ep.publication_id')
+            ->select('op.publication_id');
+
         return DB::table('submission_chapter_settings AS scs')
             ->join('submission_chapters AS sc', 'scs.chapter_id', '=', 'sc.chapter_id')
             ->join('publications AS p', 'sc.publication_id', '=', 'p.publication_id')
@@ -324,6 +335,7 @@
             ->where('scs.setting_name', '=', "pub-id::{$pubIdType}")
             ->where('scs.setting_value', '=', $pubId)
             ->where('sc.chapter_id', '<>', $excludePubObjectId)
+            ->whereNotIn('sc.publication_id', $otherVersions)
             ->where('s.context_id', '=', $contextId)
             ->count() > 0;
     }
