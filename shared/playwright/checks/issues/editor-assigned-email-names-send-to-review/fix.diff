+ * Distributed under the GNU GPL v3. For full terms see the file LICENSE.
+ *
+ * @class EditorAssignSendForReview
+ *
+ * @brief The editor assignment letter asked editors to select "Send to Review",
+ *   a button that reads "Send for Review" since 3.4 (pkp/pkp-lib#7265). Correct
+ *   the stored copies of the letter that still hold the old label.
+ *
+ * Runs after I12593_EmailToTaskTemplates, which moves the Submission stage's
+ * "Assign Editor" letter (EDITOR_ASSIGN_SUBMISSION) into a task template.
+ */
+
+namespace APP\migration\upgrade\v3_6_0;
+
+use Illuminate\Support\Facades\DB;
+use PKP\install\DowngradeNotSupportedException;
+
+class EditorAssignSendForReview extends \PKP\migration\upgrade\v3_5_0\I13128_FixEmailUrlLinks
+{
+    /** [search, replace, locale]: the English label, and Mongolian's English label in brackets */
+    protected const LABELS = [
+        ['"Send to Review"', '"Send for Review"', null],
+        ['(Send to Review)', '(Send for Review)', 'mn'],
+    ];
+
+    public function up(): void
+    {
+        foreach (self::LABELS as [$search, $replace, $locale]) {
+            // The automatic letter: its default body and a journal's own edit
+            $this->replace('EDITOR_ASSIGN', $search, $replace, '', $locale);
+
+            // The "Assign Editor" letter of the Submission stage, a task template since 3.6
+            $rows = DB::table('edit_task_template_settings AS s')
+                ->join('edit_task_templates AS t', 't.edit_task_template_id', '=', 's.edit_task_template_id')
+                ->where('t.key', 'EDITOR_ASSIGN_SUBMISSION')
+                ->where('s.setting_name', 'description')
+                ->when($locale !== null, fn ($query) => $query->where('s.locale', $locale))
+                ->where('s.setting_value', 'LIKE', '%' . $search . '%')
+                ->get(['s.edit_task_template_setting_id', 's.setting_value']);
+
+            foreach ($rows as $row) {
+                DB::table('edit_task_template_settings')
+                    ->where('edit_task_template_setting_id', $row->edit_task_template_setting_id)
+                    ->update(['setting_value' => str_replace($search, $replace, $row->setting_value)]);
+            }
+        }
+    }
+
+    public function down(): void
+    {
+        throw new DowngradeNotSupportedException();
+    }
+}
