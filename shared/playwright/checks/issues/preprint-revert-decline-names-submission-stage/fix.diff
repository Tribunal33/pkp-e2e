+ * @class RevertDeclineEmailName
+ *
+ * @brief Reinstall the default "Revert Decline" email so that its stored name
+ *  is the preprint server's, not the journal's "...Without Review".
+ */
+
+namespace APP\migration\upgrade\v3_6_0;
+
+use APP\facades\Repo;
+use PKP\install\DowngradeNotSupportedException;
+use PKP\migration\Migration;
+
+class RevertDeclineEmailName extends Migration
+{
+    public function up(): void
+    {
+        Repo::emailTemplate()->dao->installEmailTemplates(
+            templatesFile: Repo::emailTemplate()->dao->getMainEmailTemplatesFilename(),
+            emailKey: 'EDITOR_DECISION_REVERT_INITIAL_DECLINE',
+        );
+    }
+
+    /**
+     * @throws DowngradeNotSupportedException
+     */
+    public function down(): void
+    {
+        throw new DowngradeNotSupportedException();
+    }
+}
