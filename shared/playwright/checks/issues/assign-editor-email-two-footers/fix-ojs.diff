@@ -118,6 +118,21 @@
 "<p>Kind regards,</p>"
 "{$contextSignature}"
 
+msgid "emails.editorAssignSubmission.body"
+msgstr ""
+"<p>Dear {$recipientName},</p>"
+"<p>The following submission has been assigned to you to see through the editorial process.</p>"
+"<p><a href=\"{$submissionUrl}\">{$submissionTitle}</a><br />"
+"{$authors}</p>"
+"<p><b>Abstract</b></p>"
+"{$submissionAbstract}"
+"<p>If you find the submission to be relevant for {$contextName}, please forward the submission to the review stage by "
+"selecting \"Send to Review\" and then assign reviewers by clicking \"Add Reviewer\".</p>"
+"<p>If the submission is not appropriate for this journal, please decline the submission.</p>"
+"<p>Thank you in advance.</p>"
+"<p>Kind regards,</p>"
+"{$signature}"
+
 msgid "emails.editorAssignReview.body"
 msgstr ""
 "<p>Dear {$recipientName},</p>"
