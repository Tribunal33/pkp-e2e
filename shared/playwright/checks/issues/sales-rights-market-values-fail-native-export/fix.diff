     /**
+     * @copydoc Form::validate()
+     */
+    public function validate($callHooks = true)
+    {
+        // ONIX requires the territory of an entry that is not "Rest of World" to include at least
+        // one country or region.
+        if (!$this->getData('ROWSetting') && !array_filter((array) $this->getData('countriesIncluded')) && !array_filter((array) $this->getData('regionsIncluded'))) {
+            $this->addError('countriesIncluded', __('grid.catalogEntry.territoryRequired'));
+        }
+        return parent::validate($callHooks);
+    }
