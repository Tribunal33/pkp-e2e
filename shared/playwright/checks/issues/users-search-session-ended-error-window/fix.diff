--- /dev/null
+++ b/lib/ui-library/src/utils/loginRequired.js
@@ -0,0 +1,15 @@
+/**
+ * Whether an API answer says that the request had no signed-in user while this
+ * page was rendered for one: the browser's session has ended since
+ *
+ * @param {Number} status The answer's HTTP status
+ * @param {Object} data The answer's JSON body
+ * @return {Boolean}
+ */
+export function isLoginRequired(status, data) {
+	return (
+		status === 401 &&
+		data?.error === 'user.authorization.loginRequired' &&
+		!!(typeof pkp !== 'undefined' && pkp?.currentUser?.id)
+	);
+}
