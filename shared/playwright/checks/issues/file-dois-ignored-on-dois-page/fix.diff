     /**
+     * Join each publication format's files as the DOIs page lists them:
+     * the proof files assigned to the format (APP\publication\maps\Schema).
+     */
+    protected function joinFormatProofFiles(JoinClause $join): JoinClause
+    {
+        return $join->on('current_sf.assoc_id', '=', 'current_pf.publication_format_id')
+            ->where('current_sf.assoc_type', '=', Application::ASSOC_TYPE_REPRESENTATION)
+            ->where('current_sf.file_stage', '=', SubmissionFile::SUBMISSION_FILE_PROOF);
+    }
