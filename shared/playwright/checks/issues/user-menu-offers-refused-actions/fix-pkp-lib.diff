     /**
+     * Of the given users, those who hold the Site Administrator role now. Nobody may
+     * administer them (Validation::getAdministrationLevel()).
+     *
+     * @return int[]
+     */
+    public function siteAdminIds(array $userIds): array
+    {
+        if (empty($userIds)) {
+            return [];
+        }
+
+        return UserUserGroup::query()
+            ->withUserIds($userIds)
+            ->withActive()
+            ->whereHas('userGroup', fn ($query) => $query->where('role_id', Role::ROLE_ID_SITE_ADMIN))
+            ->pluck('user_user_groups.user_id')
+            ->map(fn ($id) => (int) $id)
+            ->unique()
+            ->values()
+            ->all();
+    }
