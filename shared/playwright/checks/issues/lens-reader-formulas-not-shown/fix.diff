+<script type="text/javascript">{literal}
+	// MathJax 3 reads its configuration from window.MathJax as it loads, so it is set before the script.
+	window.MathJax = {
+		options: {
+			menuOptions: {
+				settings: {
+					assistiveMml: true
+				}
+			},
+			renderActions: {
+				// Lens writes a TeX formula as a MathJax 2 <script type="math/tex">, which MathJax 3 no longer looks for.
+				// Added beside the default "find" action, so TeX delimiters and MathML in the text are still found.
+				findScript: [10, function (doc) {
+					var tex = null, scripts = document.querySelectorAll('script[type^="math/tex"]');
+					for (var j = 0; j < doc.inputJax.length; j++) {
+						if (doc.inputJax[j].name === 'TeX') tex = doc.inputJax[j];
+					}
+					for (var i = 0; tex && i < scripts.length; i++) {
+						var node = scripts[i];
+						var math = new doc.options.MathItem(node.textContent, tex, /; *mode=display/.test(node.type));
+						var text = document.createTextNode('');
+						node.parentNode.replaceChild(text, node);
+						math.start = {node: text, delim: '', n: 0};
+						math.end = {node: text, delim: '', n: 0};
+						doc.math.push(math);
+					}
+				}, '']
+			}
+		}
+	};
+{/literal}</script>
